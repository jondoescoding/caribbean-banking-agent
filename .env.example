# Browserbase resolves the project from this key. Do not add BROWSERBASE_PROJECT_ID.
BROWSERBASE_API_KEY=
BROWSERBASE_CONTEXT_ID=

# JMMB credentials are local-only and are used only when live reads are explicitly enabled.
JMMB_USERNAME=
JMMB_PASSWORD=
JMMB_LOGIN_URL=https://moneyline.jmmb.com/personal/login.php
JMMB_ACCOUNTS_URL=https://moneyline.jmmb.com/personal/app/accsum/
JMMB_LIVE_ENABLED=false

PORT=3000
LOG_LEVEL=info
